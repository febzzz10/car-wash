{
  "name": "@washpro/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "wrangler deploy --env=\"\"",
    "dev": "wrangler dev --env=\"\"",
    "predeploy": "node scripts/validate-production-deploy.mjs",
    "db:migrate": "wrangler d1 migrations apply washpro-dev --remote",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@washpro/contracts": "workspace:*",
    "@washpro/domain": "workspace:*",
    "hono": "^4.12.31",
    "pdf-lib": "^1.17.1"
  }
}
