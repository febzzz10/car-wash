{
  "name": "@washpro/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "build:remote-dev": "wrangler deploy --dry-run --env remote-dev --outdir dist",
    "dev": "wrangler dev --env=\"\"",
    "dev:local": "wrangler dev --local --env=\"\"",
    "dev:remote": "wrangler dev --env remote-dev",
    "predeploy": "node scripts/validate-production-deploy.mjs",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:remote-dev": "wrangler deploy --env remote-dev",
    "db:migrate:remote-dev": "wrangler d1 migrations apply DB --remote --env remote-dev",
    "migrate:local": "wrangler d1 migrations apply DB --local --env=\"\"",
    "premigrate:remote": "node scripts/validate-production-deploy.mjs",
    "migrate:remote": "wrangler d1 migrations apply DB --remote --env=\"\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@washpro/contracts": "1.0.0",
    "@washpro/domain": "1.0.0",
    "hono": "^4.12.31",
    "pdf-lib": "^1.17.1"
  }
}
