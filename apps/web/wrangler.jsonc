{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "washpro-web",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "API",
      "service": "car-wash"
    }
  ]
}
