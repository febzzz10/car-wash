{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "washpro-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "API",
      "service": "car-wash"
    }
  ]
}
