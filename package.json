{
  "name": "washpro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:api": "pnpm --filter @washpro/api build",
    "build:web": "pnpm --filter @washpro/web build",
    "cloudflare:migration:backup": "node tools/cloudflare-migration/cli.mjs backup",
    "cloudflare:provision:verify": "node tools/cloudflare-migration/cli.mjs verify-resources",
    "deploy:api": "npm run deploy --workspace=@washpro/api",
    "deploy:web": "pnpm --filter @washpro/web build && node apps/web/scripts/validate-web-deploy.mjs && pnpm --dir apps/web exec wrangler deploy --config wrangler.jsonc",
    "dev": "npm run dev --workspace @washpro/web",
    "dev:api": "npm run dev --workspace @washpro/api",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,jsonc,html}\" \"packages/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tools/**/*.mjs\" \"e2e/**/*.ts\" \"*.{json,js,ts,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,jsonc,html}\" \"packages/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"tools/**/*.mjs\" \"e2e/**/*.ts\" \"*.{json,js,ts,mjs}\"",
    "lint": "eslint .",
    "pretest": "npm run test:deployment && npm run test:migration",
    "test": "npm run test --workspaces --if-present",
    "test:deployment": "node --test scripts/cloudflare-deployment.test.mjs",
    "test:migration": "node --test scripts/cloudflare-migration.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
